{
    "request": {
        "urlPath": "/sl73izp6.api.sandbox.checkout.com/payments",
        "method": "POST",
        "headers": {
            "Authorization": {
                "equalTo": "Bearer sk_test_123456"
            }
        },
        "bodyPatterns": [
            {
                "matchesJsonPath": "$[?(@.cardHolder == 'John Doe Johnson')]"
            },
            {
                "matchesJsonPath": "$[?(@.cardNumber == '1111111111111111')]"
            },
            {
                "matchesJsonPath": "$[?(@.amount == 1000)]"
            },
            {
                "matchesJsonPath": "$[?(@.cardExpiryYear == '27')]"
            },
            {
                "matchesJsonPath": "$[?(@.cardExpiryMonth == '12')]"
            },
            {
                "matchesJsonPath": "$[?(@.cvv == '123')]"
            }
        ]
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": "application/json"
        },
        "jsonBody": {
            "status": "success",
            "amount": 1000,
            "currency": "USD",
            "message": "you have successfully paid with card"
        }
    }
}