{
    "request": {
        "urlPath": "/sl73izp6.api.sandbox.checkout.com/payments",
        "method": "POST",
        "headers": {
            "Authorization": {
                "equalTo": "Bearer sk_test_123456"
            }
        },
        "bodyPatterns": [
            {
                "matchesJsonPath": "$[?(@.source.number == '')]"
            },
            {
                "matchesJsonPath": "$[?(@.source.type == 'card')]"
            },
            {
                "matchesJsonPath": "$[?(@.source.cvv == '100')]"
            },
            {
                "matchesJsonPath": "$[?(@.currency == '')]"
            },
            {
                "matchesJsonPath": "$[?(@.amount == 0)]"
            },
            {
                "matchesJsonPath": "$[?(@.processing_channel_id == '')]"
            }
        ]
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": "application/json"
        },
        "jsonBody": {
            "currency": "USD",
            "amount": 1000,
            "processing_channel_id": "pc_test_123",
            "message": "Payment failed: Missing required data"
        }
    }
}