{
    "request": {
        "urlPath": "/sl73izp6.api.sandbox.checkout.com/payments",
        "method": "POST",
        "bodyPatterns": [
            {
                "matchesJsonPath": "$[?(@.source.cvv =~ /\\D+/)]"
            }
        ]
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": "application/json"
        },
        "jsonBody": {
            "currency": "USD",
            "amount": 1000,
            "processing_channel_id": "pc_test_123",
            "message": "Payment failed: invalid CVV"
        }
    }
}