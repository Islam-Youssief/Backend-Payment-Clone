{
  "request": {
	"urlPath": "/api.stripe.com/v1/login",
	"method": "POST",
	"headers":{
	  "Authorization":{
		"equalTo": "Bearer INVALID_USER_TOKEN"
	  }
	}
  },

  "response": {
	"status":200,
	"headers":{
	  "Content-Type": "application/json"
	},
