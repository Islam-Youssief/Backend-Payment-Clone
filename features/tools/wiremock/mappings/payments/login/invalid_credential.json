{
  "request": {
    "urlPath": "/api.stripe.com/v1/login",
    "method": "POST",
    "bodyPatterns": [
      {
      "matchesJsonPath":"$[?(@.password == 'WrongPassword123')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "message": "password or Email is wrong",
      "status": "invalid_credentials"
    }
  }
}