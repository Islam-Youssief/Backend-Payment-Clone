{
  "request": {
    "urlPath": "/api.stripe.com/v1/login",
    "method": "POST",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer EXPIRED_TOKEN"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "message": "Token expired",
      "status": "expired_token"

    }
  }
}