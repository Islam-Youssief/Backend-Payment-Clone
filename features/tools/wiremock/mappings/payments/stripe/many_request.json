{
  "request": {
    "urlPath": "/api.stripe.com/v1/payments_intents",
    "method": "POST",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.cardNumber == '2222222222222222')]"
      }
    ]
  },
  "response": {
    "status": 429,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "message": "Too many requests",
      "status": "rate_limited"
    }
  }
}