# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
# Options: lcl (local) | stg (staging) | prd (production)
ENV=

# ──────────────────────────────────────────────
# PayPal
# Dashboard: https://developer.paypal.com/dashboard
# ──────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Fawry
# Dashboard: https://developer.fawrystaging.com
# ──────────────────────────────────────────────
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# ──────────────────────────────────────────────
# Stripe
# Dashboard: https://dashboard.stripe.com/apikeys
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ──────────────────────────────────────────────
# Checkout.com
# Dashboard: https://hub.checkout.com
# ──────────────────────────────────────────────
CHECKOUT_PREFIX_CODE=
CHECKOUT_SECRET_KEY=

# ──────────────────────────────────────────────
# Paymob
# Dashboard: https://accept.paymob.com → Settings → Account Info
# ──────────────────────────────────────────────
PAYMOB_SECRET_KEY=
