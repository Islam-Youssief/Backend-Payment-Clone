{
  "request": {
    "urlPath": "/api.stripe.com/v1/payments_intents",
    "method": "POST",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.visa_number == '4222422242224222')]"
      }
    ],
    "headers":{
      "Authorization":{
        "equalTo": "Bearer STRIPE_SECRET_KEY"
      }
    }
  },

  "response": {
    "status":200,
    "headers":{
      "Content-Type": "application/json"
    },
    "jsonBody":{
      "message": "Payment Successful"
    }
  }
}