{
  "request": {
    "method": "POST",
    "url": "/fawry/pay_with_visa",
    "bodyPatterns": [
      {
        "equalToJson": "{\"amount\": 100.50}",
        "ignoreArrayOrder": true,
        "ignoreExtraElements": false
      }
    ]
  },
  "response": {
    "status": 400,
    "jsonBody": {
      "statusCode": 400,
      "message": "Missing fields: ['merchantRefNum', 'cardNumber', 'cardExpiryYear', 'cardExpiryMonth', 'cvv']"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
