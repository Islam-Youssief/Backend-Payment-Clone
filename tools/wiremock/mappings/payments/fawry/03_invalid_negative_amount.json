{
  "request": {
    "method": "POST",
    "url": "/fawry/pay_with_visa",
    "bodyPatterns": [
      {
        "equalToJson": "{\"merchantRefNum\": \"ORDER_123460\", \"amount\": -50.00, \"cardNumber\": \"4111111111111111\", \"cardExpiryYear\": \"25\", \"cardExpiryMonth\": \"12\", \"cvv\": \"123\"}",
        "ignoreArrayOrder": true,
        "ignoreExtraElements": false
      }
    ]
  },
  "response": {
    "status": 400,
    "jsonBody": {
      "statusCode": 400,
      "message": "Amount must be greater than zero"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
