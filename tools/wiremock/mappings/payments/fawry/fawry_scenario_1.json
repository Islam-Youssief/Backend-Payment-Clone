        "equalToJson": "{\"merchantRefNum\": \"ORDER_123456\", \"customerProfileId\": \"CUST_987\", \"amount\": 100.50, \"cardNumber\": \"4111111111111111\", \"cardExpiryYear\": \"25\", \"cardExpiryMonth\": \"12\", \"cvv\": \"123\"}",
        "ignoreArrayOrder": true,
        "ignoreExtraElements": false
      }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "statusCode": 200,
      "message": "Operation done successfully",
      "orderStatus": "PAID"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
